# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Default timezone for new accounts (clients' browsers set their own on signup)
APP_TIMEZONE="Europe/London"

# Public base URL, used for invite links
APP_URL="https://coachedbyabz.com"

# Private photo storage: "local" (a directory on a persistent disk) or "s3" (any S3-compatible bucket, kept private)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""          # e.g. Cloudflare R2 / Backblaze endpoint; leave blank for AWS
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Fallback links (the coach can change these in Coach > Settings without redeploying)
TALLY_URL="https://tally.so/r/your-form-id"
CALENDLY_URL="https://calendly.com/your-handle/pt-consultation"
