# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Default timezone for new accounts (clients' browsers set their own on signup)
APP_TIMEZONE="Europe/London"

# Public base URL, used for invite links. On Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_URL="https://coachedbyabz.com"

# One-time /setup page for creating the first coach without a terminal (24+ chars).
# Remove it once the coach account exists.
# SETUP_TOKEN=""

# Private photo storage: "local" (a directory on a persistent disk) or "s3" (any S3-compatible bucket, kept private)
STORAGE_DRIVER="local"
# STORAGE_DIR="./storage"  # leave unset on Railway: the attached volume is used automatically
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""          # e.g. Cloudflare R2 / Backblaze endpoint; leave blank for AWS
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Fallback application link (the coach can change it in Coach > Settings without redeploying)
TALLY_URL="https://tally.so/r/your-form-id"

# ---------- Email (optional) ----------
# Leave these unset and the app works without email (you copy invite and reset links by hand).
# To switch emails on: create a Resend account (resend.com), verify your own domain there,
# then set these. Emails can't be sent from a railway.app address.
# RESEND_API_KEY=""
# EMAIL_FROM="Coached by ABZ <coach@yourdomain.com>"
# EMAIL_REPLY_TO="ablofe1@gmail.com"
# DISABLE_REMINDERS="1"   # set to turn off the hourly check-in reminder emails
