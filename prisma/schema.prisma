generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COACH
  CLIENT
}

enum CheckInFrequency {
  WEEKLY
  MONTHLY
}

enum Goal {
  FAT_LOSS
  MUSCLE_GAIN
  RECOMP
  STRENGTH
}

enum TokenKind {
  INVITE
  RESET
}

enum TaskFrequency {
  ONCE
  DAILY
  WEEKLY
}

enum LeadStatus {
  NEW
  CONTACTED
  ACCEPTED
  DECLINED
}

enum FoodSource {
  BUILTIN // the app's own list of common foods
  OFF // Open Food Facts product (cached by barcode)
  CUSTOM // created by a client from a label
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

enum PhotoPose {
  FRONT
  SIDE
  BACK
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  timezone     String   @default("Europe/London")
  createdAt    DateTime @default(now())

  sessions       Session[]
  clientProfile  ClientProfile? @relation("ClientUser")
  coachedClients ClientProfile[] @relation("CoachClients")
  templates      WorkoutTemplate[]
  tokens         AuthToken[]      @relation("TokenCreator")
  replies        CheckInReply[]
  leads          Lead[]           @relation("CoachLeads")

  communityMember    CommunityMember?    @relation("CommunityMember")
  communityMembers   CommunityMember[]   @relation("CommunityOwner")
  communityOwned     CommunityMessage[]  @relation("CommunityOwner")
  communityMessages  CommunityMessage[]  @relation("CommunityAuthor")
  communityReactions CommunityReaction[]
  communityReports   CommunityReport[]
  pushSubscriptions  PushSubscription[]
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuthToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  kind       TokenKind
  email      String
  name       String
  coachId    String
  coach      User      @relation("TokenCreator", fields: [coachId], references: [id], onDelete: Cascade)
  userId     String? // set for RESET tokens
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ClientProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  user              User             @relation("ClientUser", fields: [userId], references: [id], onDelete: Cascade)
  coachId           String
  coach             User             @relation("CoachClients", fields: [coachId], references: [id])
  goal              Goal             @default(RECOMP)
  startDay          String // YYYY-MM-DD
  checkInFrequency  CheckInFrequency @default(WEEKLY)
  checkInWeekday    Int              @default(0) // 0 = Sunday … 6 = Saturday
  checkInMonthDay   Int              @default(1) // 1-28
  nutritionNotes    String           @default("")
  coachNotes        String           @default("") // private to coach
  healthConsentAt   DateTime? // when the client agreed to health data + photo processing (UK GDPR explicit consent)
  termsAcceptedAt   DateTime? // when the client accepted the terms and health disclaimer
  lastReminderDueDay String? // check-in due date we last emailed a reminder for (prevents duplicates)
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())

  targets      NutritionTarget[]
  plans        TrainingPlan[]
  workoutLogs  WorkoutLog[]
  dailyLogs    DailyLog[]
  checkIns     CheckIn[]
  measurements Measurement[]
  photos       ProgressPhoto[]
  tasks        Task[]
  foods        Food[]
  foodEntries  FoodEntry[]
  lead         Lead?

  @@index([coachId])
}

/// Target history: the row with the latest effectiveDay <= a given day applies to that day.
model NutritionTarget {
  id           String        @id @default(cuid())
  clientId     String
  client       ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calories     Int
  proteinG     Int
  carbsG       Int
  fatG         Int
  stepGoal     Int
  effectiveDay String // YYYY-MM-DD
  createdAt    DateTime      @default(now())

  @@index([clientId, effectiveDay])
}

model WorkoutTemplate {
  id        String             @id @default(cuid())
  coachId   String
  coach     User               @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name      String
  notes     String             @default("")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  exercises TemplateExercise[]
}

model TemplateExercise {
  id         String          @id @default(cuid())
  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order      Int
  name       String
  sets       Int
  reps       String
  notes      String          @default("")
}

model TrainingPlan {
  id             String        @id @default(cuid())
  clientId       String
  client         ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String
  notes          String        @default("")
  workoutsPerWeek Int          @default(3)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  workouts       PlanWorkout[]

  @@index([clientId, active])
}

model PlanWorkout {
  id        String         @id @default(cuid())
  planId    String
  plan      TrainingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  order     Int
  name      String
  notes     String         @default("")
  exercises PlanExercise[]
  logs      WorkoutLog[]
}

model PlanExercise {
  id            String      @id @default(cuid())
  planWorkoutId String
  planWorkout   PlanWorkout @relation(fields: [planWorkoutId], references: [id], onDelete: Cascade)
  order         Int
  name          String
  sets          Int
  reps          String
  notes         String      @default("")
}

model WorkoutLog {
  id            String        @id @default(cuid())
  clientId      String
  client        ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planWorkoutId String?
  planWorkout   PlanWorkout?  @relation(fields: [planWorkoutId], references: [id], onDelete: SetNull)
  name          String
  day           String // YYYY-MM-DD
  notes         String        @default("")
  createdAt     DateTime      @default(now())
  sets          SetLog[]

  @@index([clientId, day])
}

model SetLog {
  id           String     @id @default(cuid())
  workoutLogId String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseName String
  exerciseKey  String // normalised lower-case name, used to group lift history
  setNumber    Int
  weightKg     Float
  reps         Int

  @@index([exerciseKey])
}

/// One row per client per day. Null fields mean "not logged" and render as gaps.
model DailyLog {
  id        String        @id @default(cuid())
  clientId  String
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  day       String // YYYY-MM-DD
  weightKg  Float?
  calories  Int?
  proteinG  Int?
  carbsG    Int?
  fatG      Int?
  steps     Int?
  fromDiary Boolean       @default(false) // calories/macros are totals of the food diary
  updatedAt DateTime      @updatedAt

  @@unique([clientId, day])
}

model CheckIn {
  id              String           @id @default(cuid())
  clientId        String
  client          ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type            CheckInFrequency
  day             String // YYYY-MM-DD submitted (client local)
  bodyWeightKg    Float?
  sleepHours      Float?
  sleepQuality    Int // 1-5
  energy          Int // 1-5
  trainingRating  Int // 1-5
  trainingNotes   String           @default("")
  nutritionRating Int // 1-5
  nutritionNotes  String           @default("")
  wins            String           @default("")
  struggles       String           @default("")
  questions       String           @default("")
  createdAt       DateTime         @default(now())
  replies         CheckInReply[]

  @@index([clientId, createdAt])
}

model CheckInReply {
  id        String   @id @default(cuid())
  checkInId String
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Measurement {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  day      String
  chestCm  Float?
  waistCm  Float?
  hipsCm   Float?
  armCm    Float?
  thighCm  Float?
  neckCm   Float?
  notes    String        @default("")
  createdAt DateTime     @default(now())

  @@index([clientId, day])
}

model ProgressPhoto {
  id         String        @id @default(cuid())
  clientId   String
  client     ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  day        String
  pose       PhotoPose
  storageKey String        @unique
  mimeType   String
  createdAt  DateTime      @default(now())

  @@index([clientId, day])
}

model Task {
  id          String           @id @default(cuid())
  clientId    String
  client      ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  notes       String           @default("")
  frequency   TaskFrequency    @default(ONCE)
  dueDay      String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  completions TaskCompletion[]
}

model TaskCompletion {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  day    String

  @@unique([taskId, day])
}

/// A food with values per 100 g (or 100 ml). Built-in and Open Food Facts rows are shared;
/// CUSTOM rows belong to one client.
model Food {
  id            String         @id @default(cuid())
  source        FoodSource
  name          String
  brand         String         @default("")
  barcode       String?
  unit          String         @default("g") // "g" or "ml"
  kcal          Float
  proteinG      Float
  carbsG        Float
  fatG          Float
  servingG      Float?
  servingLabel  String         @default("")
  ownerClientId String?
  ownerClient   ClientProfile? @relation(fields: [ownerClientId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  entries       FoodEntry[]

  @@index([source, barcode])
  @@index([ownerClientId])
}

/// One food logged in a meal. Name and nutrition are copied at the time of logging,
/// so the diary never changes if a food is later edited.
model FoodEntry {
  id        String        @id @default(cuid())
  clientId  String
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  day       String // YYYY-MM-DD
  meal      MealSlot
  foodId    String?
  food      Food?         @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name      String
  brand     String        @default("")
  amount    Float? // grams or ml; null for a quick add
  unit      String        @default("g")
  kcal      Float
  proteinG  Float
  carbsG    Float
  fatG      Float
  createdAt DateTime      @default(now())

  @@index([clientId, day])
}

/// An application for online coaching, made on the public site.
/// Linked to the client profile once the applicant signs up (and deleted with it).
/// Applications that never become clients are deleted automatically after 12 months.
model Lead {
  id            String         @id @default(cuid())
  coachId       String
  coach         User           @relation("CoachLeads", fields: [coachId], references: [id], onDelete: Cascade)
  clientId      String?        @unique
  client        ClientProfile? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status        LeadStatus     @default(NEW)
  name          String
  email         String
  phone         String         @default("") // no longer asked; kept for older applications
  instagram     String         @default("") // username without @
  goal          String
  experience    String
  daysPerWeek   Int?
  trainsAt      String
  about         String
  injuries      String         @default("")
  health        Json // { questionKey: true | false }
  healthDetails String         @default("")
  heardFrom     String         @default("")
  consentAt     DateTime // agreed to terms, privacy and use of health answers
  coachNotes    String         @default("")
  invitedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([coachId, status])
  @@index([email])
}

/// One member of a coach's community chat. Clients join by choice; the coach is added automatically.
model CommunityMember {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation("CommunityMember", fields: [userId], references: [id], onDelete: Cascade)
  coachId     String // whose community
  coach       User      @relation("CommunityOwner", fields: [coachId], references: [id], onDelete: Cascade)
  displayName String
  joinedAt    DateTime  @default(now())
  lastReadAt  DateTime  @default(now())
  removedAt   DateTime? // removed by the coach: can't read or post
  notify      String    @default("all") // community notifications: "all", "coach" (ABZ's messages only) or "off"

  @@index([coachId])
}

model CommunityMessage {
  id        String              @id @default(cuid())
  coachId   String
  coach     User                @relation("CommunityOwner", fields: [coachId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                @relation("CommunityAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String // may be empty when there's a photo
  imageKey  String? // private storage key of an attached photo
  imageW    Int?
  imageH    Int?
  pinnedAt  DateTime?
  createdAt DateTime            @default(now())
  reactions CommunityReaction[]
  reports   CommunityReport[]

  @@index([coachId, createdAt])
}

model CommunityReaction {
  id        String           @id @default(cuid())
  messageId String
  message   CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([messageId, userId, emoji])
}

model CommunityReport {
  id         String           @id @default(cuid())
  messageId  String
  message    CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([messageId, reporterId])
}

/// One device that has turned on notifications (a Web Push subscription).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
